{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:XPL_API_KEY}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "cost": {
            "input": 0.1,
            "output": 0.5
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1050000,
            "output": 384000
          },
          "cost": {
            "input": 0.021,
            "output": 0.042
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4.1-flash-uncensored": {
          "name": "DeepSeek V4.1 Flash Uncensored",
          "limit": {
            "context": 1050000,
            "output": 393000
          },
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache_read": 0.03
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": {
            "context": 1050000,
            "output": 393000
          },
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache_read": 0.006
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
  "lsp": true,
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "axiom", "effect": "ask" }
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "oauth": {},
      "enabled": false
    }
  }
}
